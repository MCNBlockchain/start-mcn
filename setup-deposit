#!/bin/sh
set -eu
root=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3,10) else "Требуется Python 3.10+")'
python3 "$root/tools/setup-deposit.py"
python3 -m venv "$root/.tools/deposit"
"$root/.tools/deposit/bin/python" -m pip install "$root/.tools/ethstaker"
