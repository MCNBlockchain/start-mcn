#!/usr/bin/env python3
"""Install pinned upstream Linux clients into the repository's bin directory."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import platform
import shutil
import tarfile
import tempfile
from urllib.request import Request, urlopen

ROOT = Path(__file__).resolve().parent


def install(name, release, destination):
    if destination.is_file():
        print(f"{name} уже существует. Файл сохранён.")
        return
    print(f"Скачивание {name}…", flush=True)
    with tempfile.TemporaryDirectory(prefix=".download-", dir=destination.parent) as temporary:
        downloaded = Path(temporary) / "download"
        digest = hashlib.sha256()
        request = Request(release["url"], headers={"User-Agent": "start-mcn"})
        with urlopen(request, timeout=120) as response, downloaded.open("wb") as output:
            for chunk in iter(lambda: response.read(1024 * 1024), b""):
                digest.update(chunk)
                output.write(chunk)
        if digest.hexdigest() != release["sha256"]:
            raise ValueError(f"SHA-256 mismatch for {name}")
        executable = Path(temporary) / name
        if name == "geth":
            with tarfile.open(downloaded) as archive:
                member = archive.getmember("geth-linux-" + ARCH + "-1.17.10-1df30b18/geth")
                if not member.isfile():
                    raise ValueError("Invalid Geth archive")
                with archive.extractfile(member) as source, executable.open("wb") as output:
                    shutil.copyfileobj(source, output)
        else:
            downloaded.rename(executable)
        executable.chmod(0o755)
        # Linking avoids overwriting a binary installed by a concurrent invocation.
        try:
            os.link(executable, destination)
        except FileExistsError:
            print(f"{name} уже установлен.")
    print(f"{name}: {destination}")


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Установка Geth и Prysm для MCN")
    parser.add_argument("--validator", action="store_true", help="Также установить Prysm Validator")
    args = parser.parse_args()
    try:
        ARCH = {"x86_64": "amd64", "aarch64": "arm64"}.get(platform.machine())
        if platform.system() != "Linux" or ARCH is None:
            raise ValueError("Установка клиентов поддерживает Linux x86_64 и ARM64.")
        releases = json.loads((ROOT / "tools/clients.json").read_text())[ARCH]
        destination = ROOT / "bin"
        destination.mkdir(exist_ok=True)
        for name in ["geth", "beacon-chain"] + (["validator"] if args.validator else []):
            install(name, releases[name], destination / name)
    except (OSError, ValueError, tarfile.TarError) as error:
        parser.exit(1, f"MCN: {error}\n")
